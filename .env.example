# PostgreSQL connection from the Supabase project.
# Use the transaction pooler URL for the application and a direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Single-user local identity for the first milestone.
# This value must match the Supabase Auth user UUID and is never accepted from the browser.
NANI_OWNER_USER_ID="00000000-0000-0000-0000-000000000000"

# Reserved for the next vertical slice.
OPENCODE_BASE_URL="http://127.0.0.1:4096"
OPENCODE_MODEL=""
ENGRAM_BASE_URL=""
