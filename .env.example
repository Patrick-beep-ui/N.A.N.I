# Único archivo: copiá a .env en esta raíz. Usá Session pooler (5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Opcional: Prisma CLI usa DATABASE_URL si DIRECT_URL está vacío.
DIRECT_URL=""
# Opcional cuando la DB tiene exactamente un perfil. No es un login Auth.
NANI_OWNER_USER_ID=""
# Carpeta local autorizada. Vacío = raíz de este proyecto.
NANI_WORKING_DIRECTORY=""
OPENCODE_BASE_URL="http://127.0.0.1:4096"
OPENCODE_MODEL="opencode/big-pickle"
OPENCODE_SERVER_USERNAME="opencode"
OPENCODE_SERVER_PASSWORD=""
ENGRAM_BASE_URL="http://127.0.0.1:7437"
ENGRAM_HTTP_TOKEN=""
