    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.4",
    "@opencode-ai/sdk": "1.19.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
