{
  "name": "nani",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nani/web dev",
    "dev:worker": "pnpm --filter @nani/worker dev",
    "check": "pnpm prisma:validate && pnpm -r check && pnpm test",
    "test": "pnpm --filter @nani/engine test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
