{
  "name": "nani",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
